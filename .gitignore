# Private material: never commit keys, certs, passes or build output
*.key
*.pem
*.p12
*.pkpass
*.cer
*.csr
*.jks
*.keystore
keystore.properties
local.properties
*.certSigningRequest
*.crt
*.der
*.pfx
keys/
out/
# Your own cards hold member IDs: only the samples are tracked
cards/*
!cards/sample-card.json
!cards/sample-logo.png
# Example starting templates (fake data). Only these exact files are tracked; anything else you put in
# cards/examples/ stays ignored.
!cards/examples/
cards/examples/*
!cards/examples/loyalty-card.json
!cards/examples/loyalty-logo.png
!cards/examples/business-card.json
!cards/examples/business-logo.png
!cards/examples/wifi-guest-card.json
!cards/examples/wifi-guest-logo.png
!cards/examples/medical-card.json
!cards/examples/medical-logo.png
!cards/examples/pet-card.json
!cards/examples/pet-logo.png
!cards/examples/make_logos.py
# Build temp dirs (can hold card fields)
.makepass-*/
.verifypass-*/
.finish-*/
__pycache__/
*.pyc

# finish.sh / lock files at the repo root
.lock
*.lock
